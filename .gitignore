# Unity generated folders — do not track
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Assets/, Packages/ and ProjectSettings/ are intentionally NOT ignored.
# Unity .meta files for tracked assets must remain tracked.

# IDE / editor generated state
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity / Rider / Visual Studio generated
ExportedObj/
.consulo/
*.unityproj
*.tmp
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# Build/package artifacts
*.apk
*.aab
*.unitypackage

# Android / Gradle generated/local
.gradle/
**/build/
local.properties

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Secrets / local credentials
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
*.pem
*.key

# Test / coverage artifacts
coverage/
TestResults/

# Misc
*.log
*.bak
*.swp
*.swo
